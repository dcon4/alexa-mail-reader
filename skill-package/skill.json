{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Mail Reader",
          "summary": "Reads your unread email and sends replies, by voice.",
          "examplePhrases": [
            "Alexa, open mail reader",
            "Alexa, ask mail reader to read my email",
            "Alexa, ask mail reader how many unread"
          ],
          "keywords": [
            "email",
            "mail",
            "inbox",
            "messages"
          ]
        }
      },
      "category": "NEWS"
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://example.com/alexa",
          "sslCertificateType": "Trusted"
        }
      }
    },
    "manifestVersion": "1.0"
  }
}
